{
  "schema_version": 1,
  "backend_order": [
    "OPTIX",
    "CUDA",
    "HIP",
    "ONEAPI",
    "METAL"
  ],
  "guards": {
    "min_available_gib": 2,
    "rss_limit_gib": 10,
    "max_swap_out_mib": 16,
    "probe_timeout_seconds": 300
  },
  "profiles": [
    {
      "id": "colab-t4-small",
      "automatic": true,
      "match": {
        "environment": "colab",
        "gpu_name_pattern": "Tesla T4",
        "max_cpu_count": 2,
        "min_gpu_memory_mib": 12288,
        "max_pixels": 409600,
        "min_cpu_count": 2
      },
      "settings": {
        "denoiser_prefilter": "ACCURATE",
        "denoiser_quality": "HIGH",
        "max_bounces": 4,
        "diffuse_bounces": 2,
        "glossy_bounces": 2,
        "transparent_bounces": 4,
        "renderer_initialization": "guarded",
        "device": "GPU",
        "denoiser": "native-gpu-oidn",
        "workers": 2,
        "threads": 1,
        "thread_cap": 1,
        "denoiser_input_passes": "RGB_ALBEDO_NORMAL"
      },
      "evidence": "colab-denoising-v1: two1-thread processes; small fixture; bounded operational choice; paired initialization study and broader-case qualification; see docs/experiments/blender-execution-v1"
    },
